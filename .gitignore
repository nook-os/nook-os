# Rust
/target
**/*.rs.bk

# Node
node_modules/
dist/
.vite/

# Env — never commit secrets
.env
.env.local

# Deployment-specific compose (reverse proxy, TLS, hostnames) is an operator
# concern — keep it next to the checkout, out of the repo.
/docker-compose.prod.yml

# Tauri
frontend/apps/desktop/src-tauri/target

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Generated OpenAPI spec is committed intentionally (frontend/packages/api/openapi.json)
.pnpm-store/
# Tauri
frontend/apps/desktop/src-tauri/gen/

# In-container cargo target mount points
/target-docker
/target-docker-node
# Dev agent TLS — BOTH halves, generated per checkout by
# scripts/dev-bootstrap.sh. The certificate used to be tracked while its
# key was ignored, which handed every fresh worktree a certificate it had
# no key for and a control plane that booted and died (MAIN-425). Nothing
# pins this cert — the node computes its fingerprint at runtime — so a
# per-checkout pair is equivalent and costs nothing.
deploy/dev-certs/

certs/

# The fleet's Claude device-auth session (MAIN-238). Real credentials — never
# committed, and deliberately separate from the host's ~/.claude so swapping
# the fleet's identity cannot disturb a personal login.
.nook-secrets/

# Sidecar binaries staged into the desktop bundle (MAIN-395). CI stages the
# real ones from the `binaries` job; a local `tauri build` or the CI lint job
# writes stubs here. Either way they are build output, never source.
frontend/apps/desktop/src-tauri/binaries/
