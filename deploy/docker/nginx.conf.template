# Serves the built SPA and proxies the API (including WebSockets) to the
# control plane, keeping the app same-origin. ${CONTROL_PLANE_ORIGIN} is
# substituted by the stock nginx image's envsubst entrypoint.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # 8080, not 80: the chart runs this as a non-root user, and a non-root
    # process cannot bind a privileged port. `NET_BIND_SERVICE` does not rescue
    # that under Kubernetes — `capabilities.add` fills the bounding and permitted
    # sets, while an unprivileged process needs the capability AMBIENT, which
    # Kubernetes does not support (MAIN-650). An unprivileged port needs no
    # capability at all.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: client-side routes resolve to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API + live sockets + MCP + OAuth discovery → control plane.
    location ~ ^/(api|mcp|healthz|\.well-known)/? {
        proxy_pass ${CONTROL_PLANE_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Terminals are long-lived streams.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Team chat (REST + its websocket) → the chat container, keeping the SPA
    # same-origin (MAIN-48). nook-chat serves its routes at the root, so the
    # `/chat` prefix is stripped before forwarding (`/chat/api/me` → `/api/me`);
    # a pass-through would 404 every request. Reuses the $connection_upgrade map
    # above; the long read timeout is for the live socket.
    #
    # PROXY API PREFIXES, NEVER PAGE ROUTES (MAIN-173). This matched the bare
    # `/chat/` for a while, which is ALSO the SPA's Chat route — so the browser
    # asking for the page got the chat service's 404 instead of the app shell,
    # on every visit and every refresh. Matching `/chat/api` leaves `/chat` to
    # fall through to the SPA fallback above. The Vite dev proxy is narrowed the
    # same way in the same commit; if you widen one, widen neither.
    #
    # The upstream is passed through a runtime variable, not a literal, so nginx
    # resolves it per request instead of at config load. That keeps this web
    # image booting on deployments that have no chat container yet (the Helm
    # chart — MAIN-48 NG-6): a literal upstream would fail startup DNS and
    # crash-loop the whole web tier, whereas a missing backend here surfaces as
    # a 502 only when /chat is actually hit. ${CHAT_ORIGIN} (default
    # http://chat:8082) and ${DNS_RESOLVER} (default 127.0.0.11, Docker's
    # embedded DNS) are substituted by the nginx image's envsubst entrypoint,
    # like ${CONTROL_PLANE_ORIGIN}.
    location /chat/api {
        resolver ${DNS_RESOLVER} valid=10s;
        set $chat_upstream ${CHAT_ORIGIN};
        rewrite ^/chat/(.*)$ /$1 break;
        proxy_pass $chat_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }
}
